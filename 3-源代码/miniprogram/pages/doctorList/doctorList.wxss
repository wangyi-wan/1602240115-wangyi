page {
  background-color: #f2f6fa;
  padding: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #1a3a5c;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.doctor-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.doctor-department {
  display: block;
  font-size: 26rpx;
  color: #778899;
  margin-top: 12rpx;
}

.appoint-btn {
  margin-top: 24rpx;
  background-color: #2781d9;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 30rpx;
}
