.page { padding: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 28rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; margin-bottom: 32rpx; }
.row { display: flex; align-items: center; justify-content: space-between;
       padding: 26rpx 0; border-bottom: 1rpx solid #eee; }
.row:last-child { border-bottom: none; }
.label { color: #666; font-size: 30rpx; }
.value { color: #1677ff; font-size: 30rpx; }
.btn { background: #1677ff; color: #fff; border-radius: 44rpx; font-size: 32rpx; }
.hint { margin-top: 24rpx; text-align: center; color: #aaa; font-size: 24rpx; }