<view class="page">
  <view class="head">分诊指引</view>
  <view class="sub">{{date}} · 待分诊 / 在诊患者队列</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">当前没有待分诊的患者</view>

  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="appointment_id">
      <view class="top">
        <view class="name">{{item.patient_name}}</view>
        <view class="tag" style="background:{{item.color}}">{{item.statusLabel}}</view>
      </view>
      <view class="row"><text class="k">时间</text><text class="v">{{item.time}}</text></view>
      <view class="row"><text class="k">牙椅</text><text class="v">{{item.chair_code}}</text></view>
      <button wx:if="{{item.canGuide}}" class="btn" size="mini" data-id="{{item.appointment_id}}" bindtap="guide">引导到诊</button>
      <view wx:else class="row"><text class="k">分诊状态</text><text class="v">已入诊室</text></view>
    </view>
  </view>
</view>
