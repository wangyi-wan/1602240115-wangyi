/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* ===== 各角色分包页面共用的卡片 / 列表样式 ===== */
.page { padding: 24rpx; background: #f5f6f8; min-height: 100vh; box-sizing: border-box; }
.head { font-size: 34rpx; font-weight: 600; margin: 8rpx 8rpx 24rpx; color: #222; }
.sub { font-size: 26rpx; color: #999; margin: -12rpx 8rpx 24rpx; }
.empty { text-align: center; color: #999; padding: 140rpx 0; font-size: 28rpx; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card .name { font-size: 30rpx; font-weight: 600; color: #222; }
.tag { padding: 4rpx 16rpx; border-radius: 20rpx; color: #fff; font-size: 22rpx; }

.row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; font-size: 28rpx; }
.row .k { color: #888; }
.row .v { color: #222; font-weight: 500; }

.btn { margin-top: 16rpx; background: #1677ff; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.btn.warn { background: #ff4d4f; }
.btn.ghost { background: #f0f5ff; color: #1677ff; }
.btn[disabled] { opacity: 0.45; }

/* 统计卡片（院长经营指标） */
.metrics { display: flex; flex-wrap: wrap; gap: 20rpx; }
.metric { flex: 1 1 30%; background: #fff; border-radius: 16rpx; padding: 28rpx 20rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.metric .num { font-size: 48rpx; font-weight: 700; color: #1677ff; }
.metric .lbl { font-size: 24rpx; color: #888; margin-top: 8rpx; }
