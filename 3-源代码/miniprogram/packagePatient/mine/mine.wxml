<view class="page">
  <view class="head">我的预约</view>
  <view class="sub">（演示：展示诊所全部预约记录）</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">还没有预约记录</view>

  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="appointment_id">
      <view class="top">
        <view class="name">{{item.patient_name}}</view>
        <view class="tag" style="background:{{item.color}}">{{item.statusLabel}}</view>
      </view>
      <view class="row"><text class="k">预约时间</text><text class="v">{{item.time}}</text></view>
      <view class="row"><text class="k">牙椅</text><text class="v">{{item.chair_code}}</text></view>
      <button wx:if="{{item.canCancel}}" class="btn warn" size="mini" data-id="{{item.appointment_id}}" bindtap="cancel">取消预约</button>
    </view>
  </view>
</view>
