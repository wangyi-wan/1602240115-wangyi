<view class="page">
  <view class="head">
    <view class="hi">{{roleName}}工作台</view>
    <view class="out" bindtap="logout">退出</view>
  </view>

  <view class="grid">
    <view class="item" wx:for="{{menu}}" wx:key="url"
          data-url="{{item.url}}" bindtap="open">
      <view class="icon">{{item.icon}}</view>
      <view class="name">{{item.name}}</view>
    </view>
  </view>

  <view class="extra">
    <view class="line" bindtap="goReminders">
      <text>消息提醒记录（第 9 章）</text>
      <text class="go">查看 ›</text>
    </view>
  </view>
</view>